# URL do projeto: Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role (secreta!): Supabase > Project Settings > API Keys > service_role
# Ela ignora o RLS. Use só aqui no servidor, nunca no app.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que vai na URL do conector: https://seu-servidor.onrender.com/mcp/<MCP_SECRET>
# Mínimo de 24 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_SECRET=

# Porta local (o Render define a própria PORT automaticamente)
PORT=3000
