# URL do projeto: Supabase > Project Settings > API Keys / Data API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave secret / service_role (secreta!): Supabase > Project Settings > API Keys
# Ela ignora o RLS. Use só aqui no servidor, nunca no app.
SUPABASE_SERVICE_ROLE_KEY=

# Chave publishable / anon (a mesma do app): a tela de login do OAuth confere e-mail e senha com ela
SUPABASE_ANON_KEY=

# Endereço público deste servidor, sem barra no final. A URL do conector é PUBLIC_URL/mcp
# No Render: https://SEU-SERVICO.onrender.com  |  Local: http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Rota antiga /mcp/<MCP_SECRET>, só enquanto você migra o conector antigo. Depois: off
LEGACY_SECRET_ROUTE=off
# (só com LEGACY_SECRET_ROUTE=on) segredo da rota antiga, mínimo de 24 caracteres
MCP_SECRET=
# (só com LEGACY_SECRET_ROUTE=on) e-mail da conta que a rota antiga representa
LEGACY_USER_EMAIL=

# Opcional: validade dos tokens OAuth, em segundos (padrão: 1 hora e 90 dias)
# OAUTH_ACCESS_TTL=3600
# OAUTH_REFRESH_TTL=7776000

# Porta local (o Render define a própria PORT automaticamente)
PORT=3000
